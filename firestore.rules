rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isFacultyOrAdmin() {
      return isAuthenticated() && (
        getUserData().role == 'faculty' || 
        getUserData().role == 'admin'
      );
    }

    // 1. Users Collection
    // Each user can read and modify strictly their own profile.
    // Faculty/Admins can read registered user directories.
    match /users/{userId} {
      allow read: if isAuthenticated() && (isOwner(userId) || isFacultyOrAdmin());
      allow create: if isAuthenticated() && isOwner(userId);
      allow update: if isAuthenticated() && (isOwner(userId) || isFacultyOrAdmin());
      allow delete: if isAuthenticated() && getUserData().role == 'admin';
    }

    // 2. Queries Collection
    // Students can submit queries, read only their own inquiries, and reply to their own inquiries.
    // Faculty and Administrators can read all queries, update status, and attach official responses.
    match /queries/{queryId} {
      allow read: if isAuthenticated() && (
        resource.data.student_id == request.auth.uid || 
        resource.data.student_email == request.auth.token.email ||
        isFacultyOrAdmin()
      );
      
      allow create: if isAuthenticated() && (
        request.resource.data.student_id == request.auth.uid ||
        request.resource.data.student_email == request.auth.token.email
      );

      allow update: if isAuthenticated() && (
        resource.data.student_id == request.auth.uid || 
        isFacultyOrAdmin()
      );

      allow delete: if isAuthenticated() && getUserData().role == 'admin';
    }

    // 3. Faculty Directory Collection
    match /faculty/{facultyId} {
      allow read: if isAuthenticated();
      allow write: if isFacultyOrAdmin();
    }

    // 4. Knowledge Rules & System Metadata
    match /knowledge_rules/{ruleId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && getUserData().role == 'admin';
    }

    // 5. Notifications
    match /notifications/{notifId} {
      allow read, update: if isAuthenticated() && (
        resource.data.user_id == request.auth.uid
      );
      allow create: if isAuthenticated();
      allow delete: if isAuthenticated() && (
        resource.data.user_id == request.auth.uid
      );
    }
  }
}

