# ==============================================================
# FIREBASE CONFIGURATION (Google Authentication & Firestore)
# ==============================================================
# 1. Go to Firebase Console: https://console.firebase.google.com/
# 2. Create a project and add a Web App (</> icon).
# 3. Go to Project Settings -> General -> Your apps -> SDK setup and configuration.
# 4. Copy the keys below into your local `.env` file:

VITE_FIREBASE_API_KEY=AIzaSyA1234567890abcdefghijklmnopqrstuv
VITE_FIREBASE_AUTH_DOMAIN=your-college-portal.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-college-portal
VITE_FIREBASE_STORAGE_BUCKET=your-college-portal.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# ==============================================================
# SUPABASE CONFIGURATION (PostgreSQL Database & Storage)
# ==============================================================
# Obtain these from Supabase Project Settings -> API:
# https://supabase.com/dashboard/project/_/settings/api

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
